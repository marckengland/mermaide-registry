{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mermaide:schema:v1:hooks",
  "title": "Hook file",
  "description": ".mermaide/hooks/*.json and ~/.mermaide/hooks/*.json (Requirement 5). The same v1 format as Kiro's, so .kiro/hooks files load unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "hooks"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "trigger",
          "action"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "trigger": {
            "enum": [
              "PreToolUse",
              "PostToolUse",
              "SessionStart",
              "Stop",
              "UserPromptSubmit",
              "PreTaskExec",
              "PostTaskExec",
              "PostFileCreate",
              "PostFileSave",
              "PostFileDelete",
              "PreCompact",
              "PreCommit",
              "PostCommit"
            ]
          },
          "matcher": {
            "type": "string",
            "minLength": 1,
            "description": "Regular expression tested against the tool name or the file path."
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "command"
                ],
                "properties": {
                  "type": {
                    "const": "command"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600,
                    "default": 60,
                    "description": "Seconds."
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "prompt"
                ],
                "properties": {
                  "type": {
                    "const": "agent"
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
