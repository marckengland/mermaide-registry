{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mermaide:schema:v1:models",
  "title": "Models, roles, and routing",
  "description": "models.yaml (user and workspace) and catalog/models/*.yaml (Requirements 12.3, 13, 14).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:mermaide:schema:v1:defs#/$defs/modelId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:mermaide:schema:v1:defs#/$defs/roleName"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "urn:mermaide:schema:v1:defs#/$defs/modelId"
        },
        "minItems": 1
      }
    },
    "roleGlobs": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:mermaide:schema:v1:defs#/$defs/roleName"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "urn:mermaide:schema:v1:defs#/$defs/glob"
        },
        "minItems": 1
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto": {
          "type": "boolean",
          "default": false
        },
        "escalateAfterFailures": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "maxFilesBeforeEscalate": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "cacheAware": {
          "type": "boolean",
          "default": true
        },
        "reviewSampleRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        },
        "minimumAgreementSamples": {
          "type": "integer",
          "minimum": 20,
          "maximum": 10000,
          "default": 20
        },
        "minimumAgreement": {
          "type": "number",
          "minimum": 0.85,
          "maximum": 1,
          "default": 0.85
        }
      }
    },
    "providers": {
      "type": "object",
      "description": "Provider metadata, used by the catalog (catalog/models/*.yaml) and for custom OpenAI-compatible endpoints in models.yaml.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "api": {
            "type": "string",
            "format": "uri",
            "description": "Base URL of the API, when it isn't the SDK's default."
          },
          "sdk": {
            "enum": [
              "anthropic",
              "openai",
              "google",
              "openai-compatible",
              "openrouter",
              "mistral",
              "xai",
              "deepseek",
              "ollama",
              "lmstudio",
              "amazon-bedrock",
              "azure"
            ],
            "description": "Which provider adapter talks to it."
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "description": "Environment variables that can hold its key."
          },
          "local": {
            "type": "boolean"
          },
          "docs": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutput": {
          "type": "integer",
          "minimum": 1
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "output"
          ],
          "properties": {
            "input": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "type": "number",
              "minimum": 0
            },
            "cacheRead": {
              "type": "number",
              "minimum": 0
            },
            "cacheWrite5m": {
              "type": "number",
              "minimum": 0
            },
            "cacheWrite1h": {
              "type": "number",
              "minimum": 0
            },
            "reasoning": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "const": "USD",
              "default": "USD"
            },
            "per": {
              "const": "1M",
              "default": "1M"
            }
          }
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tz",
              "from",
              "to",
              "multiplier"
            ],
            "properties": {
              "tz": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "to": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "multiplier": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "cliffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aboveInputTokens",
              "scope"
            ],
            "properties": {
              "aboveInputTokens": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "enum": [
                  "request"
                ]
              },
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cacheRead": {
                "type": "number",
                "minimum": 0
              },
              "inputMultiplier": {
                "type": "number",
                "minimum": 0
              },
              "outputMultiplier": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": {
              "enum": [
                true,
                false,
                "unknown"
              ]
            },
            "parallelTools": {
              "enum": [
                true,
                false,
                "unknown"
              ]
            },
            "vision": {
              "enum": [
                true,
                false,
                "unknown"
              ]
            },
            "promptCaching": {
              "enum": [
                true,
                false,
                "unknown"
              ]
            },
            "reasoning": {
              "type": "array",
              "items": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            },
            "editFormat": {
              "enum": [
                "tool",
                "search-replace",
                "udiff",
                "whole"
              ]
            },
            "toolShim": {
              "type": "boolean"
            }
          }
        },
        "training": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "allowed",
                "not_allowed",
                "unknown"
              ]
            },
            "termsUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "description": "Whether this model's terms allow training on its outputs (Requirement 53.7)."
        },
        "local": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "preview",
            "deprecated"
          ],
          "default": "active"
        },
        "released": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Where the catalog entry's facts came from, for example models.dev@2026-09-26 or a vendor pricing URL."
        },
        "localModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parametersBillions",
            "quantizations"
          ],
          "properties": {
            "parametersBillions": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "quantizations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "weightBytes",
                  "kvBytesPerToken"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "weightBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000000000
                  },
                  "kvBytesPerToken": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
