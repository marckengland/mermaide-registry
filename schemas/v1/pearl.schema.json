{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mermaide:schema:v1:pearl",
  "title": "Pearl front-matter",
  "description": "YAML front-matter of PEARL.md, the entry file of a pearl: Mermaide's installable bundle of MCP servers, steering, skills, and hooks (Requirement 8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "keywords"
  ],
  "properties": {
    "version": {
      "$ref": "urn:mermaide:schema:v1:defs#/$defs/frontMatterVersion"
    },
    "name": {
      "$ref": "urn:mermaide:schema:v1:defs#/$defs/kebabName"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pearlVersion": {
      "$ref": "urn:mermaide:schema:v1:defs#/$defs/semver"
    },
    "author": {
      "type": "string"
    }
  }
}
